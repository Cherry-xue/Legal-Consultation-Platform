# Copy to .env. Never commit real credentials.
COOKIE_SECURE=false
SESSION_DAYS=7
ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:8091
# Shared file is used for DASHSCOPE_API_KEY only. Override here if needed.
SHARED_ENV_PATH=../../.env
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=legal_assistant
MYSQL_USER=legal_app
MYSQL_PASSWORD=replace-me
MYSQL_ROOT_PASSWORD=replace-me-too
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8100
AGENT_CONTRACT_MODEL=qwen-plus-2025-11-05
AGENT_LABOR_MODEL=qwen-plus-2025-07-14
AGENT_FAMILY_MODEL=qwen-plus-2025-04-28
AGENT_CONSUMER_MODEL=qwen3.7-flash
AGENT_PROCEDURE_MODEL=qwen-plus-2025-01-25
AGENT_COLLABORATION_MODEL=qwen3.7-max
EMBEDDING_MODEL_NAME=qwen3.7-text-embedding
EMBEDDING_BATCH_SIZE=10
ENABLE_THINKING=false
MODEL_TIMEOUT_SECONDS=30
COLLABORATION_TIMEOUT_SECONDS=75
MAX_UPLOAD_MB=10
DATA_DIR=./data
RAG_HYBRID_ENABLED=true
RAG_CANDIDATE_LIMIT=30
RAG_MAX_VECTOR_DISTANCE=0.5
RAG_MIN_LEXICAL_COVERAGE=0.28
RAG_MIN_RERANK_SCORE=0.20
